# Copy this to `.env` and edit before deploying:
#   cp .env.production.example .env

APP_NAME=GembaWalk
APP_ENV=production
APP_DEBUG=false
# Generate with the command in README ("Deploying to a home server"), then paste
# the base64:... value here.
APP_KEY=
# Used for generated URLs. On the LAN this is the address phones reach the app at.
APP_URL=http://192.168.0.7:8090

# Host port the app is published on (container listens on 8080 internally).
APP_PORT=8090
# Host port for the Mailpit web UI.
MAILPIT_UI_PORT=8091

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gembawalk
DB_USERNAME=gembawalk
DB_PASSWORD=change-me
# Used by compose for MYSQL_ROOT_PASSWORD (separate from the app's DB password).
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=gembawalk@homelab.local
MAIL_FROM_NAME="${APP_NAME}"

# Set these before the first `db:seed` so the super admin is created with your
# own credentials.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# serversideup: plain HTTP, TLS is terminated by Tailscale serve in front of it.
SSL_MODE=off
AUTORUN_ENABLED=true
